<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fills a table through the last published version 2 of the package, so that the upgrade tests
    migrate data that version 2 really wrote rather than data shaped like it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="AspNetCore.Identity.AmazonDynamoDB" Version="2.2.0" />
  </ItemGroup>

</Project>
